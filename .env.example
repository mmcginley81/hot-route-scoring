# MyFantasyLeague
# Confirmed for this league: public read access, no login/API key needed.
# Host is league-specific (MFL splits leagues across many www## servers) —
# get it from your league's URL in the browser, not the generic api.* front door.
# Using 2025 here for now since the 2026 league hasn't been rolled over yet.
MFL_LEAGUE_ID=15952
MFL_YEAR=2025
MFL_HOST=www45.myfantasyleague.com

# Bubble
# Base URL of the app, e.g. https://hot-route.app or a version-test URL
BUBBLE_APP_URL=
BUBBLE_API_TOKEN=

# Local data
MFL_PLAYER_ID_CSV=NFLPlayers_with_MFL_IDs.csv
